# What this project's tools write. A pattern with a leading `/` matches at the repository root only.

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Builds (python -m build, poetry build)
/build/
/dist/

# Tests, coverage, type checks (pytest, coverage, nox, mypy)
.pytest_cache/
.mypy_cache/
/.nox/
/.coverage*
/coverage.xml
/htmlcov/
/.local-ci/

# Documentation (sphinx-build, make docs)
/docs/_build/

# Local idtrack repositories that the README, the docs and the notebooks create in the working directory
idtrack_cache/

# Environments and editors
/.venv/
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store
